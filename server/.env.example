# Server Port
PORT=5000

# Persistent WhatsApp Session Path (Local writable disk directory)
WHATSAPP_SESSION_PATH=./whatsapp-session

# Allowed Frontend Origins (Comma-separated for multiple domains)
# Example: https://idfc-chatbot.vercel.app,http://localhost:3000
FRONTEND_URL=https://idfc-chatbot.vercel.app
ALLOWED_ORIGINS=https://idfc-chatbot.vercel.app,http://localhost:3000

# Optional: Puppeteer Custom Chrome Executable Path (if not in standard Windows/Linux location)
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable
