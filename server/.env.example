# IDFC FIRST Bank WhatsApp Business API Environment Variables
# Safe Demo Mode is enabled by default to prevent unauthorized sends during development.
DEMO_MODE=true

# Official Meta WhatsApp Cloud API Credentials
# Configure these when switching DEMO_MODE to false for live production dispatch:
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=idfc_loan_prequalified
WHATSAPP_LANGUAGE_CODE=en

PORT=5000
